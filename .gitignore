# Local credentials and personal data
config.local.*
.env
.env.*
!*.example.env

# Runtime output
logs/
screenshots/
artifacts/
*.sqlite3
*.db

# Python and editor files
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store

# Page samples collected during app exploration
pagesamples/

# Project-local Android SDK and virtual devices
.android-sdk/
.android-avd/

# GitHub archive repo (nested, managed separately)
Dunpiao/

# Pinned third-party source checkout; provenance is recorded in docs
.upstream/
.pi-sessions/

# Full local project snapshots can include ignored diagnostics and Git history
archive/snapshots/
# 归档的旧日志/页面样本（体积大，仅本地保留）
archive/logs-*/
archive/pagesamples-*/

# 上游参考 checkout（只读，不入库）
reference/

# 上游 HaTickets 运行配置（含设备序列号，不入库）
config.jsonc
mobile/config.jsonc
reference/HaTickets/mobile/config.jsonc

# macOS 大小写不敏感文件系统误伤：Dunpiao/ 规则会匹配到小写 src/dunpiao，显式豁免
!src/dunpiao/
!src/dunpiao/**
src/dunpiao/__pycache__/
